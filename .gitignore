scratch/
eval/verbose-*.log
eval/baseline-live.json
.tether/

# Environment files (preserve .env.example)
.env
.env.*
!.env.example

# Logs
/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Local agent tooling metadata
.freebuff/
