# Dependencies
node_modules/

# Build outputs & caches
dist/
.output/
.turbo/
.wxt/
.astro/
.vercel/
.wrangler/
*.tsbuildinfo

# Test and coverage artifacts
coverage/
test-results/
playwright-report/
tests/e2e/.tmp-*/

# Release artifacts — fully gitignored, manifest included.
