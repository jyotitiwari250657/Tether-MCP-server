# Relay Configuration
PORT=8787
RELAY_URL=https://mcp.tether.dev
RELAY_MODE=managed

# Long-Polling Timeout (ms)
# Defaults to 8000ms in managed mode (Vercel Hobby limit: 10s)
# Defaults to 25000ms in selfhost mode or managed on Vercel Pro/Enterprise
LONG_POLL_TIMEOUT_MS=8000

# Neon Postgres Connection String
DATABASE_URL=postgres://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel KV (Upstash Redis)
KV_REST_API_URL=https://sample-kv.upstash.io
KV_REST_API_TOKEN=sample_token_here

# JWT Signing Keypairs (Ed25519 or ES256 JWK format)
JWT_PRIVATE_KEY_JWK={"kty":"OKP","crv":"Ed25519","d":"...","x":"..."}
JWT_PUBLIC_KEY_JWK={"kty":"OKP","crv":"Ed25519","x":"..."}
