---
// PRD FR-606: Device Pairing Consent Page (Light Ribbon theme, AC-P14-07)
import '../styles/theme.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Pair Device — Tether</title>
  <style>
    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    .card {
      max-width: 440px;
      width: 100%;
      text-align: center;
      padding: 2.5rem;
    }
    h1 {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
    }
    p {
      color: var(--t-text-500);
      font-size: 0.875rem;
      margin-bottom: 2rem;
    }
    input {
      width: 100%;
      padding: 0.75rem 1rem;
      background: var(--t-surface);
      border: 1px solid var(--t-line-strong);
      border-radius: 10px;
      color: var(--t-text-900);
      font-size: 1.25rem;
      font-family: var(--t-font-mono);
      text-align: center;
      letter-spacing: 0.25rem;
      margin-bottom: 1.5rem;
      box-sizing: border-box;
      outline: none;
    }
    input:focus {
      border-color: var(--t-blue-fg);
    }
    button {
      width: 100%;
      padding: 0.75rem;
      border-radius: 12px;
      font-size: 1rem;
    }
  </style>
</head>
<body>
  <div class="t-card card">
    <h1>Pair Chrome Extension</h1>
    <p>Enter the 6-character pairing code shown in your Tether extension popup.</p>
    <input type="text" maxlength="6" placeholder="ABC123" id="code-input" />
    <button type="button" id="confirm-btn" class="t-btn-gradient">Confirm Device Pairing</button>
  </div>
</body>
</html>
